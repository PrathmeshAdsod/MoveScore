# ============================================================
# Agentic Cinema — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# ---- Google Cloud -----------------------------------------
# Your GCP project ID (e.g. agentic-cinema-12345)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# GCS bucket name for temporary uploaded/generated files
# (auto-deleted after 24 hours via lifecycle rule)
GCS_TEMP_BUCKET=agentic-cinema-temp

# GCP region where Cloud Run services will be deployed
GCP_REGION=us-central1

# ---- Authentication (local dev only) ----------------------
# For local development ONLY — do NOT use in Cloud Run.
# In production, use an attached service account (ADC).
# Run: gcloud auth application-default login
# OR uncomment and point to your downloaded key file:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ---- Gemini -----------------------------------------------
# Your Gemini API key from https://aistudio.google.com/apikey
# Used for both Gemini model calls AND Lyria music generation.
GEMINI_API_KEY=your-gemini-api-key

# Gemini model ID for choreography analysis + music planning.
# Verified: gemini-3.8-flash (see ai.google.dev/gemini-api/docs/models/gemini-3.8-flash)
# May have a version suffix (e.g. gemini-3.8-flash-001) — verify exact string in your console.
GEMINI_MODEL=gemini-3.8-flash

# ---- Lyria ------------------------------------------------
# Lyria model ID for music generation (via google-genai SDK).
# Verified: lyria-3.5 (see ai.google.dev/gemini-api/docs/music-generation)
# Verify exact ID in your AI Studio account before running proof scripts.
LYRIA_MODEL=lyria-3.5

# ---- App --------------------------------------------------
# FastAPI backend port (local dev)
PORT=8080

# Allowed frontend origin for CORS (set to Cloud Run URL in production)
# For local dev: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Max upload size in MB
MAX_VIDEO_SIZE_MB=100

# Signed URL TTL for final video download (hours)
SIGNED_URL_TTL_HOURS=1

# Cloud Run request timeout in seconds (must match --timeout flag)
CLOUD_RUN_TIMEOUT_SECONDS=600

# ---- Frontend (Next.js public env vars) -------------------
# These are read by the Next.js frontend at build time.
# NEXT_PUBLIC_ prefix makes them available in the browser.
# Set this to your deployed backend Cloud Run URL in production.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
